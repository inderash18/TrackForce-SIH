# PAIMANA Sentinel AI - Environment Configuration
APP_ENV=production
PROJECT_NAME="PAIMANA Sentinel AI"

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://paimana_user:paimana_password_2026@localhost:5432/paimana_sentinel_db

# Cache & Queues (Redis & Celery)
REDIS_URL=redis://localhost:6379/0

# Security (JWT Secrets)
JWT_SECRET=paimana-sentinel-ultra-secure-key-2026-gov-ai-intelligence
JWT_REFRESH_SECRET=paimana-refresh-secret-jwt-key-2026-secure

# Self-Hosted Ollama Qwen LLM
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
