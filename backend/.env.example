# ==============================================================================
# PAIMANA Sentinel AI — Backend Environment Configuration
# Location: backend/.env
# ==============================================================================

# Application Environment
APP_ENV=production
PROJECT_NAME="PAIMANA Sentinel AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Connection
# SQLite (Local Dev / Render Free): sqlite:///./paimana_sentinel.db
# PostgreSQL (Production): postgresql://paimana_user:password@localhost:5432/paimana_sentinel_db
DATABASE_URL=sqlite:///./paimana_sentinel.db

# JWT Security Secrets (Generate unique 32+ character strings for production)
JWT_SECRET=paimana-sentinel-ultra-secure-key-2026-gov-ai-intelligence
JWT_REFRESH_SECRET=paimana-refresh-secret-jwt-key-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cache & Message Broker (Optional / Celery)
REDIS_URL=redis://localhost:6379/0

# Self-Hosted Ollama Local LLM Engine
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# CORS Allowed Origins (Comma-separated or JSON list of frontend URLs)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://trackforce-sih.vercel.app","*"]
